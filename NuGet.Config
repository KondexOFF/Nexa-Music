<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet source for the Windows build of plugins that install NuGet packages
  at configure time (webview_flutter_windows: Microsoft.Web.WebView2 and
  Microsoft.Windows.ImplementationLibrary). Project-local, so the machine's
  own NuGet settings stay untouched (E2.0, 2026-10-26).
-->
<configuration>
  <packageSources>
    <add key="nexa-nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
